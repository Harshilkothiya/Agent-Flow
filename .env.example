# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace (for generating Text Embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Qdrant Vector Database (for RAG Document Storage)
